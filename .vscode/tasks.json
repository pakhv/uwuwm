{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/Fo${workspaceFolder}\\build\\",
                "/Fd${workspaceFolder}\\build\\",
                "/Fe${workspaceFolder}\\build\\uwuwm.exe",
                "${workspaceFolder}\\src\\structs.c",
                "${workspaceFolder}\\src\\common.c",
                "${workspaceFolder}\\src\\eventloop.c",
                "${workspaceFolder}\\src\\main.c",
                "/link",
                "ole32.lib",
                "oleaut32.lib",
                "User32.lib",
                "Dwmapi.lib"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "shell",
            "label": "Post build - Add manifest",
            "command": "mt.exe",
            "args": [
                "-manifest",
                "${workspaceFolder}\\resources\\uwuwm.exe.manifest",
                "-outputresource:${workspaceFolder}\\build\\uwuwm.exe;1",
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Build",
            "dependsOn": [
                "C/C++: cl.exe build",
                "Post build - Add manifest"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ],
    "version": "2.0.0"
}